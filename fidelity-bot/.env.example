# ── Plaid ────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# sandbox | development | production
PLAID_ENV=sandbox
# Comma-separated Plaid access tokens for each linked account
PLAID_ACCESS_TOKENS=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack (optional) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL=#portfolio-alerts

# ── Email / Resend (optional) ─────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=portfolio-bot@yourdomain.com
EMAIL_TO=you@yourdomain.com

# ── App settings ──────────────────────────────────────────────────────────────
# Path to SQLite database file
DB_PATH=./data/portfolio.db
# Directory for daily JSON snapshots
SNAPSHOTS_DIR=./data/snapshots
# Alert thresholds
ALERT_DRIFT_THRESHOLD=0.05        # 5 % absolute position drift
ALERT_DAILY_LOSS_THRESHOLD=0.02   # 2 % single-day portfolio loss
# Scheduler cron (daily digest at 6 PM ET)
SCHEDULER_CRON_HOUR=18
SCHEDULER_CRON_MINUTE=0

# ── Auto-Research (Karpathy-style) ────────────────────────────────────────────
# Enable autonomous research + gains-maximising optimisation in the daily job
RESEARCH_ENABLED=true
# Max number of individual positions to research in depth per run
# Higher = more thorough but more API tokens (each ticker = ~3k tokens)
RESEARCH_MAX_TICKERS=5
